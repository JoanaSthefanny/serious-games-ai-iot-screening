# ============================================================
# Environment variables
# ============================================================

# Copy this file and rename the copy to:
# .env
#
# Never commit your real .env file or API keys to GitHub.


# ============================================================
# Gemini API
# ============================================================

# Required for LLM-assisted screening.
#
# Create/manage your Gemini API key:
# https://aistudio.google.com/apikey
#
# Documentation:
# https://ai.google.dev/gemini-api/docs/api-key

GEMINI_API_KEY=YOUR_GEMINI_API_KEY


# ============================================================
# Springer Nature API
# ============================================================

# Optional.
# Required only for Springer metadata/abstract enrichment.
#
# Springer Nature Developer Portal:
# https://dev.springernature.com/
#
# Authentication documentation:
# https://dev.springernature.com/docs/quick-start/authentication/

SPRINGER_API_KEY=YOUR_SPRINGER_API_KEY